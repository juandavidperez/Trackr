# ─────────────────────────────────────────────────────────────────────────────
# nginx — sert l'application Angular et fait proxy de /api vers le backend.
#
# Ce fichier est un *template* : au démarrage du conteneur, l'image nginx
# remplace ${BACKEND_URL} par la variable d'environnement du même nom
# (valeur par défaut définie dans le Dockerfile) puis écrit le résultat dans
# /etc/nginx/conf.d/default.conf. Les variables nginx ($uri, $host...) ne sont
# pas touchées car elles ne sont pas des variables d'environnement.
# ─────────────────────────────────────────────────────────────────────────────
server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Ne pas révéler la version de nginx dans les en-têtes et pages d'erreur.
    server_tokens off;

    # En-têtes de sécurité de base (hérités par les blocs location sans add_header).
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Compression gzip
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml text/javascript image/svg+xml;
    gzip_min_length 256;

    # Sonde de santé du conteneur (Docker HEALTHCHECK, Kubernetes probes).
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # API : même origine que le frontend → pas de CORS, pas d'URL figée au build.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # On écrase X-Forwarded-For avec l'IP réellement vue par nginx :
        # un client ne peut plus usurper une autre IP pour contourner le rate limiting.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    # Fichiers versionnés par Angular (hash dans le nom) : cache long.
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # index.html ne doit jamais être mis en cache : il référence les nouveaux bundles.
    location = /index.html {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    # SPA : toute route inconnue (/login, /projects/3...) renvoie index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
